# ============================================================
# Carter's Care NDIS Platform - Production Environment Config
# ============================================================

# 1. DATABASE CONFIGURATION
# ============================================================

# PostgreSQL Connection (Required)
DATABASE_URL=postgresql://user:password@host:5432/carterscare

# For Supabase:
# DATABASE_URL=postgresql://postgres.xxxxx:password@xxxxx.supabase.co:5432/postgres

# For Vercel PostgreSQL:
# DATABASE_URL=postgresql://...

# For AWS RDS:
# DATABASE_URL=postgresql://admin:password@carterscare-db.xxxxx.amazonaws.com:5432/carterscare


# 2. AUTHENTICATION CONFIGURATION
# ============================================================

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your-jwt-secret-key-here

# Session Configuration
SESSION_SECRET=your-session-secret-key-here
SESSION_TIMEOUT_MINUTES=480

# Password Security
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRES_UPPERCASE=true
PASSWORD_REQUIRES_NUMBERS=true
PASSWORD_REQUIRES_SPECIAL_CHARS=true
PASSWORD_EXPIRY_DAYS_ADMIN=90
PASSWORD_EXPIRY_DAYS_SUPPORT_WORKER=180


# 3. EMAIL CONFIGURATION (Optional)
# ============================================================

# For password resets and notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_EMAIL=noreply@carterscare.com.au
SMTP_FROM_NAME="Carter's Care"


# 4. FILE STORAGE CONFIGURATION
# ============================================================

# Vercel Blob Storage:
BLOB_READ_WRITE_TOKEN=your-blob-token-here

# Or AWS S3:
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=carterscare-documents

# Or Google Cloud Storage:
GCS_PROJECT_ID=your-project-id
GCS_PRIVATE_KEY=your-private-key
GCS_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com


# 5. ENCRYPTION CONFIGURATION
# ============================================================

# For encrypting sensitive data at rest (generate with: openssl rand -base64 32)
ENCRYPTION_KEY=your-encryption-key-here
ENCRYPTION_ALGORITHM=aes-256-cbc


# 6. API & DEPLOYMENT CONFIGURATION
# ============================================================

# API Base URL
API_URL=https://api.carterscare.com.au
FRONTEND_URL=https://carterscare.com.au

# Environment
NODE_ENV=production
DEBUG=false

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100


# 7. LOGGING & MONITORING
# ============================================================

# Error Tracking (optional)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
LOG_LEVEL=info

# Analytics (optional)
POSTHOG_API_KEY=your-posthog-api-key


# 8. MFA CONFIGURATION (Phase 4)
# ============================================================

# TOTP (Time-based One-Time Password) for authenticator apps
MFA_ISSUER=Carters Care
MFA_WINDOW=1  # Allow 1 time window tolerance


# 9. COMPLIANCE & PRIVACY
# ============================================================

# GDPR/Privacy Act compliance
DATA_RETENTION_DAYS=2555  # 7 years
AUDIT_LOG_RETENTION_DAYS=2555
SOFT_DELETE_RETENTION_DAYS=90  # Before hard delete

# HIPAA/Healthcare compliance (if applicable)
ENABLE_HIPAA_AUDIT=true


# 10. NDIS & AGED CARE SPECIFIC
# ============================================================

# Provider Registration Numbers
NDIS_PROVIDER_ID=your-provider-id
AGED_CARE_PROVIDER_ID=your-aged-care-id

# Compliance Framework
COMPLIANCE_FRAMEWORK=ndis  # or 'aged_care' or 'both'


# 11. FEATURE FLAGS
# ============================================================

# Enable/disable features in production
FEATURE_MFA_ENABLED=true
FEATURE_AUDIT_LOGGING=true
FEATURE_DOCUMENT_VERSIONING=true
FEATURE_EXPORT_REPORTS=true
FEATURE_API_RATE_LIMITING=true


# 12. SUPPORT & CONTACT
# ============================================================

SUPPORT_EMAIL=support@carterscare.com.au
SUPPORT_PHONE=+61-2-XXXX-XXXX
ORGANIZATION_NAME="Your Organization Name"
ORGANIZATION_ABN=AB123456789


# ============================================================
# DEPLOYMENT INSTRUCTIONS
# ============================================================

# 1. Generate all secrets:
#    - JWT_SECRET: openssl rand -base64 32
#    - SESSION_SECRET: openssl rand -base64 32
#    - ENCRYPTION_KEY: openssl rand -base64 32

# 2. Set up file storage:
#    - Choose Vercel Blob, AWS S3, or Google Cloud Storage

# 3. Configure email service:
#    - Use Gmail, SendGrid, Mailgun, or your SMTP provider

# 4. Set up error tracking (optional):
#    - Integrate Sentry for production error monitoring

# 5. For Vercel deployment:
#    - Set all variables in Vercel Project Settings > Environment Variables

# 6. For other platforms (Render, Railway, etc.):
#    - Upload this file securely or set variables via platform UI

# 7. Database:
#    - Run migrations: 
#      - phase3_compliance_hardening.sql
#      - phase4_security_upgrades.sql

# 8. Test deployment:
#    - Verify all services are connected
#    - Check logs for errors
#    - Run smoke tests

# 9. Monitor in production:
#    - Check error tracking (Sentry)
#    - Monitor application logs
#    - Review audit logs regularly


# ============================================================
# SECURITY BEST PRACTICES
# ============================================================

# ✓ Never commit this file to version control (add to .gitignore)
# ✓ Rotate secrets every 90 days
# ✓ Use separate dev, staging, and production configs
# ✓ Enable HTTPS/TLS everywhere
# ✓ Set up CORS properly for frontend
# ✓ Implement rate limiting on all APIs
# ✓ Use secure cookies (httpOnly, secure, sameSite)
# ✓ Enable security headers (CSP, X-Frame-Options, etc.)
# ✓ Keep dependencies updated
# ✓ Regular security audits (npm audit, snyk)
# ✓ Backup database regularly
# ✓ Enable database encryption at rest
# ✓ Monitor all admin activities
# ✓ Implement incident response procedures
