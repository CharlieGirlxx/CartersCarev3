# Development Environment Configuration Template
# 
# Instructions:
# 1. Copy this file to .env.local
# 2. Fill in your actual values (get them from your team)
# 3. Never commit .env.local to version control
# 4. Don't share this file with anyone
#
# Security Warning:
# - This file contains sensitive information
# - Always use HTTPS for API URLs in production
# - Rotate keys regularly
# - Never log these values

################################################################################
# APPLICATION SETTINGS
################################################################################

# Environment type (development, staging, production)
NODE_ENV=development

# Application URL (for CORS, redirects, etc.)
APP_URL=http://localhost:5173

################################################################################
# API CONFIGURATION
################################################################################

# API Server URL - Used by frontend to communicate with backend
API_URL=http://localhost:3001

# API Server Port - Where the Express server listens
API_PORT=3001

# API Host - Interface to bind to
API_HOST=0.0.0.0

################################################################################
# DATABASE CONFIGURATION
################################################################################

# PostgreSQL Connection String (if using database)
# Format: postgresql://username:password@host:port/database
# DATABASE_URL=postgresql://user:password@localhost:5432/carterscare

# MongoDB Connection String (if using MongoDB)
# MONGODB_URI=mongodb://localhost:27017/carterscare

# Database Logging (development only)
# DATABASE_LOG=true

################################################################################
# AUTHENTICATION & SECURITY
################################################################################

# JWT Secret for signing tokens (generate a strong random string)
# AUTH_SECRET=your-secret-key-here-min-32-chars

# Session Configuration
# SESSION_SECRET=your-session-secret-here

# CORS Configuration (comma-separated domains)
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
# RATE_LIMIT_ENABLED=false
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100

################################################################################
# EXTERNAL SERVICES
################################################################################

# Stripe (Payment Processing)
# STRIPE_PUBLIC_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Email Service (SendGrid, AWS SES, etc.)
# EMAIL_SERVICE=sendgrid
# EMAIL_API_KEY=your-email-api-key
# EMAIL_FROM=noreply@carterscare.com

# Cloud Storage (AWS S3, Vercel Blob, etc.)
# STORAGE_TYPE=s3
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
# AWS_S3_BUCKET=carterscare-dev
# AWS_S3_REGION=us-east-1

################################################################################
# LOGGING & DEBUGGING
################################################################################

# Log Level (error, warn, info, debug, trace)
LOG_LEVEL=debug

# Enable detailed logging
DEBUG=true

# Enable API request/response logging
API_LOGGING=true

# Enable database query logging
SQL_LOGGING=false

################################################################################
# DEVELOPMENT TOOLS
################################################################################

# Hot Module Replacement (Vite)
VITE_HMR_HOST=localhost
VITE_HMR_PORT=5173

# Source Maps
GENERATE_SOURCEMAP=true

# API Debugging
API_DEBUG=false

################################################################################
# FEATURE FLAGS
################################################################################

# Enable experimental features for development
ENABLE_EXPERIMENTAL_FEATURES=false

# Feature-specific toggles
# FEATURE_NEW_DASHBOARD=true
# FEATURE_DARK_MODE=true

################################################################################
# MONITORING & ANALYTICS
################################################################################

# Error Tracking (Sentry, etc.)
# SENTRY_DSN=https://...

# Analytics
# ANALYTICS_ENABLED=false
# ANALYTICS_KEY=your-key

################################################################################
# FILE UPLOADS & MEDIA
################################################################################

# Max file upload size (in bytes)
MAX_FILE_SIZE=10485760  # 10MB

# Allowed file extensions
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx

# Temporary upload directory
UPLOAD_TEMP_DIR=./uploads/temp
UPLOAD_DIR=./uploads

################################################################################
# CACHE CONFIGURATION
################################################################################

# Cache Type (memory, redis, disabled)
CACHE_TYPE=memory

# Cache TTL (Time to Live) in seconds
CACHE_TTL=3600

# Redis Configuration (if CACHE_TYPE=redis)
# REDIS_URL=redis://localhost:6379/0

################################################################################
# TESTING & QA
################################################################################

# Test Database URL (for running tests)
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/carterscare_test

# Seed Database on Development
# SEED_DATABASE=true

# Test Mode
TEST_MODE=false
